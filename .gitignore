# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Data — raw immutable files and processed artifacts
data/ai4privacy/raw/
data/mimic/
data/annotated/

# Pretrained embeddings (large, downloadable — e.g. GloVe 6B 100d)
data/embeddings/

# Model checkpoints
models/**/*.bin
models/**/*.pt
models/**/*.safetensors
models/**/*.ckpt

# Ensemble cached probabilities (regeneratable)
ensemble/cache/

# K-fold CV artifacts — per-fold checkpoints, vocabs, and cached probabilities
# (regeneratable). The aggregated summary evaluation/results/kfold_cv.json is kept.
models/**/checkpoint/kfold/
evaluation/results/kfold/

# OS
.DS_Store
